<resources>
    <!-- Launch theme only: Compose supplies the real colours once it starts.
         Setting windowBackground here keeps the cold-start frame from
         flashing a colour the app never uses. -->
    <style name="Theme.DoryBrain" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/canvas_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
